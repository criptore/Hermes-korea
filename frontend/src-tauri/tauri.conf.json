{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HERMES",
  "version": "1.1.0",
  "identifier": "fr.hermes.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HERMES — Tender Watch & Response",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Automated public tender watch and response, 100% local.",
    "longDescription": "HERMES watches public tender portals, analyses tender documents with a local LLM and drafts responses. Everything runs on your machine; final submission always stays human.",
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3ODZFOTg0NzU5NjRBMTcKUldRWFNwWjFoT21HWnhURjZ6dzNJNkRKalJwc0xvdnFXYmFjeXQyLzZ1YUZQTWkxSU1BQUo0eXkK",
      "endpoints": [
        "https://github.com/criptore/Hermes-korea/releases/latest/download/latest.json"
      ]
    }
  }
}
